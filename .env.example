APP_NAME="cenefco-api"
APP_ENV=local
APP_KEY=base64:B/n6IMmF0uZRoJulMz94xnd1CLsNHMxx5ws+g2GB0Z4=
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Motor de base de datos: PostgreSQL en producción/staging. SQLite solo para dev local sin instalación.
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=cenefco_api
DB_USERNAME=YOUR_DB_USERNAME
DB_PASSWORD=YOUR_DB_PASSWORD
# Sin esto, Postgres usa el timezone del SO del servidor, rompiendo comparaciones de fecha+hora.
DB_TIMEZONE=America/La_Paz

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Minutos hasta que expira un token de Sanctum (login del panel admin)
SANCTUM_TOKEN_EXPIRATION_MINUTES=480

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@cenefco.gob.bo"
MAIL_FROM_NAME="${APP_NAME}"

SANCTUM_STATEFUL_DOMAINS=localhost:4200,127.0.0.1:4200
SESSION_DOMAIN=localhost

WHATSAPP_PHONE_NUMBER_ID=YOUR_WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_ACCESS_TOKEN=YOUR_WHATSAPP_ACCESS_TOKEN
WHATSAPP_VERIFY_TOKEN=YOUR_WHATSAPP_VERIFY_TOKEN
WHATSAPP_APP_SECRET=YOUR_WHATSAPP_APP_SECRET
WHATSAPP_API_VERSION=v22.0

TELEGRAM_BOT_TOKEN=                
TELEGRAM_ADMIN_CHAT_ID=            

BOT_cenefco_NOMBRE="cenefco"
BOT_cenefco_SIGLA=cenefco
BOT_UBICACION_DIRECCION="Plaza Principal s/n"
BOT_UBICACION_REFERENCIA="Frente a la Plaza Principal"
BOT_MAPS_LINK=https://maps.google.com/?q=cenefco+municipal
BOT_LATITUD=-17.3895
BOT_LONGITUD=-66.1568
BOT_TELEFONO="+591 2 XXXXXXX"
BOT_EMAIL=info@cenefco.gob.bo
BOT_WEB=https://www.cenefco.gob.bo

OLLAMA_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
AI_MAX_TOKENS=200
AI_TEMPERATURE=0.3
AI_TIMEOUT_SECONDS=90
PRISM_REQUEST_TIMEOUT=90
AI_MAX_INPUT_CHARS=500

WEBHOOK_URL=https://affects-passengers-indie-brunette.trycloudflare.com

ASSET_URL=https://sbjct-bachelor-furnished-msie.trycloudflare.com

BOT_QR_IMAGE_URL=https://tu-dominio.com/storage/qr-pago.png

ZOOM_ACCOUNT_ID=YOUR_ZOOM_ACCOUNT_ID
ZOOM_CLIENT_ID=YOUR_ZOOM_CLIENT_ID
ZOOM_CLIENT_SECRET=YOUR_ZOOM_CLIENT_SECRET
ZOOM_TIMEZONE=America/La_Paz

# Pasarela de pago online activa — sin webhook_secret, el webhook rechaza toda request (ver PagosYaService)
PAGOSYA_API_KEY=
PAGOSYA_WEBHOOK_SECRET=

# Client ID de Google Cloud (OAuth) para "Iniciar sesión con Google" en cenefco-portal
GOOGLE_CLIENT_ID=

# Servicio externo de certificados (proyecto certicados-web) — ver API.md
# Local: http://localhost:8000/api — Producción: https://certificados.cenefco.com/api
CERTIFICADOS_EXTERNOS_URL=http://localhost:8000/api
CERTIFICADOS_EXTERNOS_TOKEN=

# Secreto compartido para validar llamadas webhook desde el sistema de Certificados (Django)
CERTIFICADOS_WEBHOOK_SECRET=cambia-esto-por-un-secreto-seguro

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
TIPO_CAMBIO_USD_BOB=6.96
